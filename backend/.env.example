PROJECT_NAME="LegalSathi AI"
ENVIRONMENT="development"
DEBUG=True

# Database
DATABASE_URL="sqlite:///./legalsathi.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legalsathi"

# Security - REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# Admin bootstrap (optional). Leave blank to skip auto-creation.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOWED_ORIGIN_REGEX="https://.*\\.vercel\\.app"

# AI
GEMINI_API_KEY=""

# Feature flags
PII_REDACTION_ENABLED=True
RAG_EVALUATION_ENABLED=False
RATE_LIMIT_ENABLED=True
