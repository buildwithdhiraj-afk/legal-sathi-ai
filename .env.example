# =====================================================================
# LegalSathi AI - environment template
# Copy to backend/.env (backend reads backend/.env) and fill in values.
# =====================================================================

# --- Required -------------------------------------------------------
# The app refuses to start without a SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------------
# SQLite for local dev; use a Postgres URL in production
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./legalsathi.db

# --- AI -------------------------------------------------------------
GEMINI_API_KEY=

# --- Frontend / CORS ------------------------------------------------
# Comma-separated EXACT origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deploys (empty string disables)
ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)?(vercel\.app|github\.io)
FRONTEND_URL=http://localhost:3000

# --- Rate limiting --------------------------------------------------
RATE_LIMIT_ENABLED=true
# Number of trusted reverse proxies in front of the app (0 = none)
TRUSTED_PROXY_COUNT=0

# --- Admin bootstrap (optional) -------------------------------------
# When ADMIN_EMAIL + ADMIN_PASSWORD are set and no admin exists, one is
# created at startup. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=

# --- Email verification (optional) ----------------------------------
# When SMTP is unconfigured, verification is skipped and accounts are
# activated immediately.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@legalsathi.ai

# --- Optional Supabase (unused when blank) --------------------------
SUPABASE_URL=
SUPABASE_KEY=
